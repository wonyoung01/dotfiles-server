bindsym $mod+g mode "go"

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# power menu (lock / suspend / logout / reboot / shutdown) via rofi
bindsym $mod+Shift+e exec --no-startup-id ~/.config/rofi/powermenu.sh

# lock the screen quickly
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1e1e2e

# screenshots (flameshot) — $mod combos (no Print key needed on TKL)
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Ctrl+s  exec --no-startup-id flameshot full -c
# Print key fallback (works too if your TKL has one)
bindsym Print exec --no-startup-id flameshot gui

# stops i3 from focusing a window just because your mouse pointer moves over it. You can still click to focus, and the window will be raised.
focus_follows_mouse no
mouse_warping none

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

#==========================================================
# Gaps & borders (Catppuccin Mocha)
#==========================================================
gaps inner 0
gaps outer 0
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 2
# hide title bars; keep a thin colored border
for_window [class=".*"] border pixel 10

# adjust gaps on the fly
bindsym $mod+plus  gaps inner current plus 5
bindsym $mod+minus gaps inner current minus 5
bindsym $mod+Shift+g gaps inner current set 10

# class                 border    bg        text      indicator child_border
